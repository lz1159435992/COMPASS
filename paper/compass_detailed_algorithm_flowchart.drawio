          <mxGeometry x="580" y="340" width="240" height="60" as="geometry" />
        </mxCell>
        
        <!-- Outer Loop Start -->
        <mxCell id="outer-start" value="Outer Loop: While True&#xa;(Line 5)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="440" width="200" height="80" as="geometry" />
        </mxCell>
        
        <!-- Trial Reset -->
        <mxCell id="trial-reset" value="Q ← Q_base; s ← Embed(Q)&#xa;last_perf ← 0&#xa;current_sequence ← []&#xa;(Lines 6-8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="560" width="240" height="80" as="geometry" />
        </mxCell>
        
        <!-- Inner Loop Start -->
