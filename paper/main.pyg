        C3: ((x^2 - y^2) + ((z * 12 + 301) % 101) + ((z - 15) * (z - 30) % 57) + ((z + 15) * (z - 30) * (z - 11) % 9) + a - b * c) > (((a * 12 + 301) % 101) + ((a - 15) * (a - 30) % 57) + ((a + 15) * (a - 30) * (a - 11) % 9))
